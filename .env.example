# Telegram Translation Bot - Environment Configuration
# Copy this file to .env and fill in your values

# ==================== Telegram API Credentials ====================
# Get these from https://my.telegram.org/apps

# Your API ID (integer)
TG_API_ID=12345678

# Your API Hash (string)
TG_API_HASH=your_api_hash_here

# ==================== Authentication ====================
# Choose ONE of the following authentication methods:

# Option 1: Bot Token (recommended for group bots)
# Get this from @BotFather on Telegram
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Option 2: User Account (for userbot mode)
# Phone number in international format
# TG_PHONE_NUMBER=+1234567890

# Session file path (optional, defaults to bot.session)
# TG_SESSION_FILE=bot.session

# ==================== Translation Service ====================
# Supported providers: libretranslate, deepl, google

# Translation provider to use
TRANSLATION_PROVIDER=libretranslate

# API key (required for DeepL, optional for LibreTranslate)
# DeepL: Get from https://www.deepl.com/pro-api
# TRANSLATION_API_KEY=your_api_key_here

# API URL (optional, for self-hosted services)
# LibreTranslate: Use your self-hosted instance URL
# TRANSLATION_API_URL=https://libretranslate.com

# Default target language (ISO 639-1 code)
DEFAULT_TARGET_LANGUAGE=en

# ==================== Bot Configuration ====================

# Comma-separated list of admin user IDs who can configure the bot
# These users can use admin commands in any chat
ADMIN_USER_IDS=123456789,987654321

# ==================== Logging ====================
# Set log level (optional)
# RUST_LOG=tg_translator=debug,grammers=info
